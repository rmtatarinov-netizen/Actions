# Базовый образ Python 3.12 (slim — без лишних пакетов, меньше размер)
FROM python:3.12-slim

# Рабочая директория внутри контейнера
WORKDIR /app

# Сначала копируем только зависимости — этот слой кэшируется и не переустанавливается при изменении кода
COPY requirements.txt .
# Устанавливаем зависимости без кэша pip для уменьшения размера образа
RUN pip install --no-cache-dir -r requirements.txt

# Копируем исходный код приложения
COPY main.py .

# Документируем порт, который слушает приложение
EXPOSE 8000

# Запуск приложения: host 0.0.0.0 нужен, чтобы сервер был доступен снаружи контейнера
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
